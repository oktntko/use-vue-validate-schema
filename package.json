{
  "name": "use-vue-validate-schema",
  "version": "1.0.2",
  "description": "Use Vue As Is, Simple Form Validation",
  "keywords": [
    "validate",
    "vue"
  ],
  "homepage": "https://github.com/oktntko/use-vue-validate-schema",
  "bugs": "https://github.com/oktntko/use-vue-validate-schema/issues",
  "license": "MIT",
  "author": "oktntko@gmail.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/oktntko/use-vue-validate-schema"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./valibot": {
      "types": "./dist/valibot/index.d.ts",
      "import": "./dist/valibot/index.es.js",
      "require": "./dist/valibot/index.cjs.js"
    },
    "./zod": {
      "types": "./dist/zod/index.d.ts",
      "import": "./dist/zod/index.es.js",
      "require": "./dist/zod/index.cjs.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build && tsc --project tsconfig.app.json --noEmit false --declaration --emitDeclarationOnly --outDir dist",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write lib",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "microdiff": "^1.6.0"
  },
  "devDependencies": {
    "@cspell/eslint-plugin": "^10.3.0",
    "@iconify/json": "^2.2.526",
    "@iconify/tailwind4": "^1.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@tsconfig/strictest": "^2.0.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.5.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "cspell": "^10.3.0",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "valibot": "^1.4.2",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitepress": "^1.6.4",
    "vitepress-plugin-tabs": "^0.9.1",
    "vitest": "^5.0.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "valibot": "^1.4.2",
    "vue": "^3.5.42",
    "zod": "^4.5.4"
  },
  "peerDependenciesMeta": {
    "valibot": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0",
      "brace-expansion@>=1.0.0 <=1.1.11": ">=1.1.12",
      "brace-expansion@>=2.0.0 <=2.0.1": ">=2.0.2",
      "vite@<=5.4.19": ">=5.4.20",
      "vite@>=5.2.6 <=5.4.20": ">=5.4.21",
      "js-yaml@>=4.0.0 <4.1.1": ">=4.1.1",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "mdast-util-to-hast@>=13.0.0 <13.2.1": ">=13.2.1",
      "vite@^6.0.0 || ^7.0.0-0": ">=8.2.2"
    }
  }
}
